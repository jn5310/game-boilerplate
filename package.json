    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
